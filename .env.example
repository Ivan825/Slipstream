# ---------- server ----------
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/slipstream
# Long random strings in production
JWT_SECRET=change-me-jwt-secret
INGEST_SECRET=change-me-ingest-secret
# Comma separated list of allowed browser origins (dev: Vite on 5173)
CLIENT_ORIGIN=http://localhost:5173
# Run the car simulator inside the server process (handy for single-service hosting)
EMBED_SIMULATOR=false
# Serve the built React app from the server (client/dist)
SERVE_CLIENT=false
# Raw telemetry is kept this long (minutes); laps, alerts and traces are kept forever
TELEMETRY_TTL_MIN=30

# ---------- race weekend ----------
# Session started on boot: practice | qualifying | race
AUTO_START_TYPE=race
RACE_LAPS=36
PRACTICE_MINUTES=15
# Multiplies the Q1/Q2/Q3 lengths (7/6/6 minutes); 0.5 halves them for a quick demo
QUALI_SCALE=1
# Seconds after a session ends before the next one starts (practice -> qualifying -> race)
AUTO_RESTART_SEC=90
# Occasional random showers on top of the ones race control schedules
RANDOM_WEATHER=true
# Scripted race storyline (overheat, rain, puncture, safety car…) for demos; toggle in Race Control
DEMO_DIRECTOR=false

# ---------- real sessions (OpenF1) ----------
# Past sessions (2023+) are free and stream on demand; nothing to configure.
# Live feed for the session running right now needs an OpenF1 subscription:
OPENF1_TOKEN=
# ...or credentials exchanged for a token automatically
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Optionally pre-download a session on boot (9636 = 2024 Brazilian GP race; 0 minutes = whole session)
REPLAY_AUTO_IMPORT=false
REPLAY_SESSION=9636
REPLAY_MINUTES=15
# stored real-session data budget in MB; least recently used sessions are dropped (they re-download on demand)
REPLAY_CACHE_MB=200

# ---------- simulator ----------
INGEST_URL=http://localhost:4000
SIM_CARS=20
SIM_HZ=20
# Network fault injection, so dedupe / reorder handling is exercised
SIM_DUP_RATE=0.004
SIM_OOO_RATE=0.004

# ---------- client (Vite) ----------
# Leave empty when the server serves the client (same origin)
VITE_API_URL=http://localhost:4000
